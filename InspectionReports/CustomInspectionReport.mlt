                <Scene h-align="center" full-path="/RshCompareInspect991E30A675C68F98/key_viewset_3d" root-type="RshCompareInspect">
                    <RatioHW>2.5</RatioHW>
                    <BackgroundColor r="255" g="255" b="255"/>
                    <GridVisible>true</GridVisible>
                    <HistogramPos>Right</HistogramPos>
                    <Mode>2D</Mode>
                    <Scene2D>
                        <CoordSys>15</CoordSys>
                        <TextHeightInPx>8</TextHeightInPx>
                        <Dpi>300</Dpi>
                        <ZoomMode>ZoomAll</ZoomMode>
                        <LabelSize>Default</LabelSize>
                        <MeasureLayoutMode>FromViewset</MeasureLayoutMode>
                        <MeasureTemplateMode>IdOnly</MeasureTemplateMode>
                        <MeasureStyle>Light</MeasureStyle>
                        <MeasureUseGradientAsBackgroundColor>true</MeasureUseGradientAsBackgroundColor>
                    </Scene2D>
                    <Scene3D>
                        <LabelDir x="0" y="0" z="1"/>
                        <IsoTextDist>0</IsoTextDist>
                        <IsoTextColor r="0" g="0" b="0"/>
                    </Scene3D>
